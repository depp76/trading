# Copy this file to .env (repo root) and fill in values. .env is gitignored.
# Loaded via src/paths.py::ENV_FILE / main.py::load_dotenv().

# KRX Open API auth key (data/collectors/krx.py) — required for KRX-sourced data.
KRX_AUTH_KEY=

# Google AI Studio API key for the Gemini-based AI filter / diagnosis features
# (gemini_helper.py). Without it those features raise a friendly RuntimeError.
GOOGLE_API_KEY=

# Optional: overrides the default Gemini model ("gemini-2.5-flash").
# GEMINI_MODEL=

# Optional: folder holding kis_appkey.txt / kis_secretkey.txt / kis_account.txt
# for KIS (한국투자증권) Open API calls (data/collectors/kis.py). Defaults to
# "D:\Source Code\Trading MCP" if unset. These credential files are NOT part of
# this repo.
# KIS_KEY_PATH=
